# ==========================================
# SENTINEL VAULT CORE - GITIGNORE
# Impeccable hygiene rules preventing leaks
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.pfx

# Exceptions: Allow template example
!.env.example

# Compiled output
dist/
build/
out/
*.tsbuildinfo

# Databases & Local Storage (Prevents committed sqlite files)
*.db
*.sqlite
*.sqlite3
prisma/dev.db

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
*.bak
*.tmp

# Test coverage
coverage/
.nyc_output/
