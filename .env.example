# ==========================================
# SENTINEL VAULT CORE - ENVIRONMENT TEMPLATE
# Copy to .env and configure real secrets.
# NEVER commit the real .env file to Git!
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Master Vault Encryption Key (Must be exactly 32 bytes / 64 hex chars for AES-256-GCM)
# Generate a new one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=your_64_character_hex_master_encryption_key_here_required_min_64_chars

# JWT & Session Secret (Must have at least 32 characters of high-entropy string)
# Generate a new one using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_super_secure_jwt_session_secret_minimum_32_characters_long

# Security & CORS Whitelist (Comma-separated origins, NO wildcard '*' in production)
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
